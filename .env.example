# Environment Configuration Template
# Copy this file to .env and customize for your environment

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Supported: sqlite, mysql, postgresql
DB_TYPE=sqlite
DB_PATH=data/data.db

# MySQL/PostgreSQL Settings (if applicable)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nonno
DB_USER=root
DB_PASSWORD=

# ============================================================================
# ADMIN SETTINGS
# ============================================================================
ADMIN_PASSWORD=change-me-to-strong-password
ADMIN_SESSION_TIMEOUT=3600

# ============================================================================
# CONTENT PUBLISHING
# ============================================================================
# Minimum words required for articles
MIN_WORDS=3000
# Maximum articles per day
DAILY_LIMIT=5
# Auto-publish on schedule
AUTO_PUBLISH=true
# Workflow: rss or web
CONTENT_WORKFLOW=rss
# Schedule interval (minutes)
AUTO_PUBLISH_INTERVAL_MINUTES=180
# Schedule interval (seconds) - alternative
AUTO_PUBLISH_INTERVAL_SECONDS=10800
# Enable AI-powered content generation
AUTO_AI_ENABLED=true

# ============================================================================
# FETCHING & CACHING
# ============================================================================
# URL cache time-to-live (seconds)
URL_CACHE_TTL_SECONDS=900
# Workflow batch size (articles per run)
WORKFLOW_BATCH_SIZE=8
# Fetch timeout (seconds)
FETCH_TIMEOUT_SECONDS=12
# Retry attempts for failed fetches
FETCH_RETRY_ATTEMPTS=3
# Backoff between retries (milliseconds)
FETCH_RETRY_BACKOFF_MS=350
# Custom user agent
FETCH_USER_AGENT=Mozilla/5.0 (compatible; VitoBot/1.0; +https://yoursite.com/bot)
# Source cooldown after fetch (seconds)
QUEUE_SOURCE_COOLDOWN_SECONDS=180
# Queue retry delay (seconds)
QUEUE_RETRY_DELAY_SECONDS=60
# Max queue retry attempts
QUEUE_MAX_ATTEMPTS=3

# ============================================================================
# SEO & METADATA
# ============================================================================
# Homepage title (max 120 chars)
SEO_HOME_TITLE=Best Auto Reviews and Tips
# Homepage description (max 160 chars)
SEO_HOME_DESCRIPTION=Discover the latest in automotive news, buying guides, and maintenance advice.
# Article title suffix
SEO_ARTICLE_TITLE_SUFFIX= | AutoCar Niche
# Default robots directive
SEO_DEFAULT_ROBOTS=index,follow
# Default Open Graph image URL
SEO_DEFAULT_OG_IMAGE=
# Twitter/X handle
SEO_TWITTER_SITE=@YourTwitterHandle
# Image alt suffix
SEO_IMAGE_ALT_SUFFIX=AutoCar Image
# Image title suffix
SEO_IMAGE_TITLE_SUFFIX=AutoCar Photo
# Auto-linking rules (semicolon-separated: keyword=>url)
SEO_AUTO_LINK_RULES=
# Auto-link to internal pages
SEO_AUTO_LINK_AUTO_INTERNAL=true
# Max internal links per article
SEO_AUTO_LINK_MAX_PER_ARTICLE=3

# ============================================================================
# ANALYTICS & TRACKING
# ============================================================================
# Google Analytics ID (G-XXXXXXXXXX, UA-XXXXXXXXXX, or AW-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=
# Google Tag Manager ID (GTM-XXXXXX)
GOOGLE_TAG_MANAGER_ID=
# Meta Pixel / Facebook Pixel ID
META_PIXEL_ID=
# Custom verification tags (semicolon-separated)
VERIFICATION_TAGS=
# Custom scripts in header (max 20KB)
CUSTOM_HEAD_SCRIPTS=
# Custom scripts in footer (max 20KB)
CUSTOM_BODY_SCRIPTS=

# ============================================================================
# ADVERTISEMENT SETTINGS
# ============================================================================
# Enable ad injection
ADS_ENABLED=false
# Injection mode: smart or interval
ADS_INJECTION_MODE=smart
# Paragraph interval (2-10)
ADS_PARAGRAPH_INTERVAL=4
# Max ad units per article (1-6)
ADS_MAX_UNITS_PER_ARTICLE=2
# Min words before first ad (80-600)
ADS_MIN_WORDS_BEFORE_FIRST=100
# Min article words to show ads (120-3000)
ADS_MIN_ARTICLE_WORDS=300
# Ad unit HTML code (max 12KB)
ADS_HTML_CODE=
# Ad unit label text (max 40 chars)
ADS_LABEL_TEXT=Advertisement
# Blocked categories (semicolon-separated)
ADS_BLOCKED_CATEGORIES=
# Blocked keywords (semicolon-separated)
ADS_BLOCKED_KEYWORDS=

# ============================================================================
# TRANSLATION SETTINGS
# ============================================================================
# Enable auto-translation
AUTO_TRANSLATE_ENABLED=false
# Target language for translation
AUTO_TRANSLATE_TARGET_LANGUAGE=ar

# ============================================================================
# SECURITY
# ============================================================================
# Exclude IPs from auto-publishing (semicolon-separated)
VISIT_EXCLUDED_IPS=
# Enable API key lock
API_LOCK_ENABLED=false
# API access key
API_ACCESS_KEY=
# CSRF token expiration (hours)
CSRF_TOKEN_EXPIRY=24
# Session secure cookie (use only with HTTPS)
SESSION_SECURE_COOKIE=false
# Rate limit: login attempts
LOGIN_MAX_ATTEMPTS=5
# Rate limit: login lockout duration (seconds)
LOGIN_LOCKOUT_DURATION=60

# ============================================================================
# PERFORMANCE
# ============================================================================
# Cache static content
CACHE_STATIC=true
# Cache expiration (seconds)
CACHE_EXPIRATION=3600
# Enable database query logging
QUERY_LOG_ENABLED=false
# Max page visits to track before cleanup
PAGE_VISITS_MAX_RECORDS=100000
